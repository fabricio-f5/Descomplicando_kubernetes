// Este documento descreve o passo a passo para preparar máquinas virtuais (VMs) para um cluster Kubernetes.

// 1. Acesso à VM

// Defina permissões seguras para sua chave AWS:

chmod 400 <sua-chave-aws>


// 2. Alterar hostname da máquina

// Acesse como root e defina um nome identificável para cada node:

sudo su -
hostnamectl set-hostname k8s-0X

// > Substitua `X` pelo número da VM (ex: k8s-01, k8s-02, k8s-03)


// 3. Desativar SWAP

// O Kubernetes não funciona corretamente com swap ativado:

sudo swapoff -a


// 4. Carregar módulos do kernel

// Crie o arquivo de configuração:

cat <<EOF | sudo tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF

// Carregue os módulos:

sudo modprobe overlay
sudo modprobe br_netfilter


// 5. Configurar parâmetros de rede

cat <<EOF | sudo tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF

// Aplicar configurações:

sudo sysctl --system


// 6. Instalar dependências básicas

sudo apt-get update
sudo apt-get install -y apt-transport-https curl

// Nota importante

// O repositório antigo do Kubernetes (`apt.kubernetes.io`) foi descontinuado.
// Use apenas o novo repositório oficial (`pkgs.k8s.io`).

// 7. Adicionar repositório Kubernetes (novo)

// Criar diretório de chaves:


sudo mkdir -p /etc/apt/keyrings

// Adicionar chave GPG:

curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.28/deb/Release.key \
  | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg


// Adicionar repositório:

echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] \
https://pkgs.k8s.io/core:/stable:/v1.28/deb/ /" \
| sudo tee /etc/apt/sources.list.d/kubernetes.list


// 8. Instalar Kubernetes

sudo apt-get update
sudo apt-get install -y kubelet kubeadm kubectl


// 9. Fixar versões (evitar upgrades automáticos)

sudo apt-mark hold kubelet kubeadm kubectl


